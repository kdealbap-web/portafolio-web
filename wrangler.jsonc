{
  // Cloudflare Pages configuration.
  //
  // This is deliberately the Pages shape and not the Workers one. A Pages
  // project does not read `main` + `assets`; it logs "does not appear to be
  // valid ... pages_build_output_dir", skips the file, and serves the output
  // statically — which 404s at the root, because with outputMode "server"
  // Angular emits index.csr.html and expects a server to render "/".
  //
  // The server bundle instead ships inside the output directory as
  // `_worker.js`, assembled by design/tools/assemble-pages.mjs. Pages picks it
  // up from there and serves everything else as static assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portafolio-web",
  "pages_build_output_dir": "dist/portafolio-web/browser",
  "compatibility_date": "2026-08-21",
  // Angular's server polyfills reach for a few Node built-ins.
  "compatibility_flags": ["nodejs_compat"]
}
